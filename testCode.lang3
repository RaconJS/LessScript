};*/
i := 0 do i++ while i < 10 => {
	print(i)
};
obj := mod {
	self := ();
	@self.msg := \{print,"hello";self.log++;};
	@self.printLog := \print,self.log;
	self 
};
{
	obj.msg();
	obj.msg();
	obj.msg();
	obj
};
