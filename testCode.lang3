{
	a:=2;
	a+=2;
	:a=b;
	\##.<,0<:a;
	health:Int=10;
	$:=nodes=a;
	obj:=(a=(b=2));
	(a=(b=v)):=(a=(b=2));
	v:=(a=(b=2)).a.b;
	(b=v):=(a=(b=2)).a;
	(a.b=v):=(a=(b=2));
};
fizbuz := \
	for {
		str := "";
		(str += "fiz") &? i in 1..=100 % 3 == 0;
		(str += "buz") &? i % 5 == 0;
		(str += "baz") &? i % 7 == 0;
		print,str;
	}
;
{//if statements
	lineBreakFile:=\{
		#file:Option(String);
		hasFile := file?&1?|0;
		hasFile?&//idea: '?.' throws if null '.' doesn't
			file.split,"\n"
		?|
			null
	};
};
odds := \!<
	for i:=0 => {
		(!>i)?&break#?;
		i+=2;
	};
;
